    add('Broadcom ', 'BCM2837_(Raspberry_Pi_3) BCM2711_(Raspberry_Pi_4) BCM2712_(Raspberry_Pi_5)');
    add('MediaTek ', 'Kompanio_500 Kompanio_520 Kompanio_828 Kompanio_1200 Kompanio_1380 Dimensity_9300 Helio_G99');
    add('Rockchip ', 'RK3399 RK3588');
    add('Ampere ', 'Altra_Q80-30 Altra_Max_M128-30 AmpereOne');
    add('NVIDIA ', 'Tegra_X1 Jetson_Orin Grace');
    add('Samsung ', 'Exynos_2200 Exynos_2400');
    add('ARM ', 'Cortex-A53 Cortex-A72 Cortex-A76 Neoverse_N1 Neoverse_V2');
    add('Huawei ', 'Kunpeng_920');
    add('Amlogic ', 'S905X3 S922X');
    add('Intel ', 'Pentium_III_933 Pentium_II_400 Pentium_MMX_166 Pentium_Pro_200 Pentium_M_740 Pentium_4_3.0 Celeron_D_330 486DX2-66 386DX-33');
    add('AMD ', 'K6-2_500 Duron_800 Athlon_XP_2500+ Athlon_64_3200+ Athlon_64_X2_4200+ Sempron_3000+ Turion_64_X2_TL-60 Athlon_II_X2_250 Phenom_X4_9550');
    // Custom dropdown (the native datalist popup is unreliable and ungrouped)
    (function () {
        var inp = $('cpuIn'), menu = $('cpuMenu'), items = [], active = -1;
        function group(c) {
            if (/Xeon|EPYC|Opteron|Threadripper PRO/.test(c)) return 'Server / workstation';
            if (/^Intel/.test(c)) return 'Intel';
            if (/^AMD/.test(c)) return 'AMD';
            return 'ARM / other';
        }
        function build() {
            var q = inp.value.toLowerCase().replace(/[^a-z0-9+ ]/g, ' ').split(/\s+/).filter(Boolean);
            var hit = CATALOG.filter(function (c) {
                var l = c.toLowerCase();
                return q.every(function (t) { return l.indexOf(t) !== -1; });
            });
            if (/^(server|xeon|epyc)$/.test(q.join(' '))) hit = CATALOG.filter(function (c) { return group(c) === 'Server / workstation'; });
            var shown = hit.slice(0, 80), html = '', last = '';
            items = shown;
            shown.forEach(function (c, i) {
                var g = group(c);
                if (g !== last) { html += '<div class="grp">' + g + '</div>'; last = g; }
                html += '<div class="opt" data-i="' + i + '">' + esc(c) + '</div>';
            });
            if (!shown.length) html = '<div class="grp">No match - your typed text will be used as-is</div>';
            else if (hit.length > shown.length) html += '<div class="grp">' + (hit.length - shown.length) + ' more - keep typing to narrow</div>';
            menu.innerHTML = html; active = -1;
            menu.hidden = false; inp.setAttribute('aria-expanded', 'true');
        }
        function close() { menu.hidden = true; inp.setAttribute('aria-expanded', 'false'); }
        function pick(i) {
            if (!items[i]) return;
            inp.value = items[i]; close();
            inp.dispatchEvent(new Event('input', { bubbles: true }));
        }
        function mark() {
            var o = menu.querySelectorAll('.opt');
            Array.prototype.forEach.call(o, function (e, i) { e.classList.toggle('on', i === active); });
            if (o[active]) o[active].scrollIntoView({ block: 'nearest' });
        }
        inp.addEventListener('input', build);
        inp.addEventListener('focus', build);
        inp.addEventListener('keydown', function (e) {
            if (menu.hidden) { if (e.key === 'ArrowDown') build(); return; }
            if (e.key === 'ArrowDown') { active = Math.min(items.length - 1, active + 1); mark(); e.preventDefault(); }
            else if (e.key === 'ArrowUp') { active = Math.max(0, active - 1); mark(); e.preventDefault(); }
            else if (e.key === 'Enter' && active >= 0) { pick(active); e.preventDefault(); }
            else if (e.key === 'Escape') close();
        });
        menu.addEventListener('mousedown', function (e) {
            var t = e.target.closest('.opt');
            if (t) { e.preventDefault(); pick(+t.getAttribute('data-i')); }
        });
        document.addEventListener('mousedown', function (e) { if (e.target !== inp && !menu.contains(e.target)) close(); });
        inp.addEventListener('blur', function () { setTimeout(close, 120); });
    })();

    // ---------- Code 128 (subset B) ----------
    var P = '212222 222122 222221 121223 121322 131222 122213 122312 132212 221213 221312 231212 112232 122132 122231 113222 123122 123221 223211 221132 221231 213212 223112 312131 311222 321122 321221 312212 322112 322211 212123 212321 232121 111323 131123 131321 112313 132113 132311 211313 231113 231311 112133 112331 132131 113123 113321 133121 313121 211331 231131 213113 213311 213131 311123 311321 331121 312113 312311 332111 314111 221411 431111 111224 111422 121124 121421 141122 141221 112214 112412 122114 122411 142112 142211 241211 221114 413111 241112 134111 111242 121142 121241 114212 124112 124211 411212 421112 421211 212141 214121 412121 111143 111341 131141 114113 114311 411113 411311 113141 114131 311141 411131 211412 211214 211232 2331112'.split(' ');
    function code128(text) {
        var vals = [104], sum = 104, i;
        for (i = 0; i < text.length; i++) {
            var c = text.charCodeAt(i);
            if (c < 32 || c > 126) c = 63;
            vals.push(c - 32); sum += (c - 32) * (i + 1);
        }
        vals.push(sum % 103); vals.push(106);
        return vals.map(function (v) { return P[v]; }).join('');
    }
    function barcodeSvg(text) {
        if (!text) return '';
        var pat = code128(text), x = 10, bars = '', bar = true;
        for (var i = 0; i < pat.length; i++) {
            var w = +pat[i];
            if (bar) bars += '<rect x="' + x + '" y="0" width="' + w + '" height="50"/>';
            x += w; bar = !bar;
        }
        return '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 ' + (x + 10) + ' 50" preserveAspectRatio="none" shape-rendering="crispEdges" fill="#000">' + bars + '</svg>';
    }

    // ---------- State ----------
    var WORK = ['Cleaned / dusted', 'Thermal paste / cooling service', 'RAM added / replaced', 'Drive added / replaced', 'OS installed / reinstalled', 'Windows / OS updates',
        'BIOS / firmware updated', 'Drivers installed', 'Data backup / migration', 'Hardware diagnostics passed', 'Virus / malware removal', 'Battery replaced',
        'Fan replaced', 'PSU replaced', 'Secure wipe', 'Burn-in / stress test', 'Network configured', 'Inventory tagged'];
    var d;
    function newId() {
        var a = 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789', s = '';
        for (var i = 0; i < 5; i++) s += a[Math.floor(Math.random() * a.length)];
        var t = new Date();
        return 'TL-' + String(t.getFullYear()).slice(2) + ('0' + (t.getMonth() + 1)).slice(-2) + '-' + s;
    }
    function today() { var t = new Date(); return t.getFullYear() + '-' + ('0' + (t.getMonth() + 1)).slice(-2) + '-' + ('0' + t.getDate()).slice(-2); }
    function blank() {
        return { mode: 'sheet', tagSize: '4x2', copies: 1, id: newId(), host: '', type: 'Desktop', customer: '', location: '', make: '', model: '', serial: '', os: '',
            cpu: '', cpuCount: '', ram: '', ramType: '', gpu: '', disks: [{ type: 'SSD', size: '', model: '' }], ip: '', mac: '',
            date: today(), tech: '', ticket: '', status: 'In progress', checks: [], work: '', parts: '', notes: '', next: '', warranty: '', log: [] };
    }

    // ---------- Form <-> state ----------
    var MODE_HINT = {
        sheet: 'Full-page work sheet: specs, checklist, notes and sign-off with a scannable barcode.',
        idtag: 'Compact system/server identification tag: name, role, specs, location and a barcode.',
        mtag: 'Maintenance record tag: ID, barcode and a service history grid you can write on and keep on the machine.'
    };
    function fill() {
        document.querySelectorAll('[data-k]').forEach(function (el) { el.value = d[el.dataset.k] == null ? '' : d[el.dataset.k]; });
        $('tagSize').value = d.tagSize; $('copies').value = d.copies;
        document.querySelectorAll('#modeSeg button').forEach(function (b) { b.classList.toggle('on', b.dataset.mode === d.mode); });
        $('tagOpts').style.display = d.mode === 'sheet' ? 'none' : '';
        $('modeHint').textContent = MODE_HINT[d.mode];
        drawDisks(); drawChecks(); drawLog(); drawRecords(); render();
    }
    function drawDisks() {
        $('disks').innerHTML = d.disks.map(function (k, i) {
            return '<div class="diskrow"><select data-di="' + i + '" data-f="type">' + ['SSD', 'NVMe', 'HDD', 'SSHD', 'eMMC', 'SD', 'USB', 'RAID'].map(function (t) { return '<option' + (t === k.type ? ' selected' : '') + '>' + t + '</option>'; }).join('') + '</select>' +
                '<input type="text" data-di="' + i + '" data-f="size" placeholder="500 GB" value="' + esc(k.size) + '">' +
                '<input type="text" data-di="' + i + '" data-f="model" placeholder="Model / serial" value="' + esc(k.model) + '">' +
                '<button class="danger tiny" data-deldisk="' + i + '" type="button">✕</button></div>';
        }).join('');
    }
    function drawChecks() {
        $('checks').innerHTML = WORK.map(function (w, i) {
            return '<label><input type="checkbox" data-ck="' + i + '"' + (d.checks.indexOf(w) >= 0 ? ' checked' : '') + '>' + esc(w) + '</label>';
        }).join('');
    }
    function drawLog() {
        $('log').innerHTML = d.log.map(function (l, i) {
            return '<div class="logrow"><input type="date" data-li="' + i + '" data-f="date" value="' + esc(l.date) + '">' +
                '<input type="text" data-li="' + i + '" data-f="work" placeholder="Work done" value="' + esc(l.work) + '">' +
                '<input type="text" data-li="' + i + '" data-f="tech" placeholder="Tech" value="' + esc(l.tech) + '">' +
                '<button class="danger tiny" data-dellog="' + i + '" type="button">✕</button></div>';
        }).join('');
    }

    document.addEventListener('input', function (e) {
        var el = e.target;
        if (el.dataset.k) d[el.dataset.k] = el.value;
        else if (el.dataset.di != null) d.disks[+el.dataset.di][el.dataset.f] = el.value;
        else if (el.dataset.li != null) d.log[+el.dataset.li][el.dataset.f] = el.value;
        else if (el.dataset.ck != null) {
            var w = WORK[+el.dataset.ck], ix = d.checks.indexOf(w);
            if (el.checked && ix < 0) d.checks.push(w); else if (!el.checked && ix >= 0) d.checks.splice(ix, 1);
        } else if (el.id === 'tagSize') d.tagSize = el.value;
        else if (el.id === 'copies') d.copies = Math.max(1, Math.min(24, +el.value || 1));
        else return;
        render();
    });
    $('modeSeg').addEventListener('click', function (e) {
        var b = e.target.closest('button'); if (!b) return;
        d.mode = b.dataset.mode; fill();
    });
    $('addDisk').onclick = function () { d.disks.push({ type: 'SSD', size: '', model: '' }); drawDisks(); render(); };
    $('disks').addEventListener('click', function (e) {
        var b = e.target.closest('[data-deldisk]'); if (!b) return;
        d.disks.splice(+b.dataset.deldisk, 1); drawDisks(); render();
    });
    $('addLog').onclick = function () { d.log.push({ date: today(), work: '', tech: d.tech }); drawLog(); render(); };
    $('logFromWork').onclick = function () {
        var w = d.checks.concat(d.work ? [d.work.replace(/\s*\n\s*/g, '; ')] : []).join(', ');
        d.log.push({ date: d.date || today(), work: w, tech: d.tech }); drawLog(); render();
    };
    $('log').addEventListener('click', function (e) {
        var b = e.target.closest('[data-dellog]'); if (!b) return;
        d.log.splice(+b.dataset.dellog, 1); drawLog(); render();
    });
    $('genId').onclick = function () { d.id = newId(); $('idIn').value = d.id; render(); };

    // ---------- Rendering ----------
    function cell(label, v) { return '<div><b>' + esc(label) + '</b>' + esc(v) + '</div>'; }
    function disksList() { return d.disks.filter(function (k) { return k.size || k.model; }); }
    function title() { return d.host || [d.make, d.model].filter(Boolean).join(' ') || d.type; }
    function barcodeBlock() { return '<div class="bc">' + barcodeSvg(d.id) + '<div class="code">' + esc(d.id) + '</div></div>'; }

    function sheetHtml() {
        var box = function (on) { return '<span class="box">' + (on ? '✓' : '') + '</span>'; };
        var rows = disksList().map(function (k) { return '<tr><td>' + esc(k.type) + '</td><td>' + esc(k.size) + '</td><td>' + esc(k.model) + '</td></tr>'; }).join('') || '<tr><td colspan="3">&nbsp;</td></tr>';
        var log = d.log.map(function (l) { return '<tr><td>' + esc(l.date) + '</td><td>' + esc(l.work) + '</td><td>' + esc(l.tech) + '</td></tr>'; }).join('');
        for (var i = d.log.length; i < 4; i++) log += '<tr><td>&nbsp;</td><td></td><td></td></tr>';
        return '<div class="sheet page">' +
            '<div class="head"><div><h1>' + esc(title()) + '</h1><div class="sub">' + esc([d.type, d.customer && ('Customer: ' + d.customer), d.location && ('Location: ' + d.location)].filter(Boolean).join('  |  ')) + '</div>' +
            '<div class="sub">Machine work sheet' + (d.ticket ? ' · Job #' + esc(d.ticket) : '') + ' · ' + esc(d.date) + '</div></div><div style="width:2.6in">' + barcodeBlock() + '</div></div>' +
            '<h3>System</h3><div class="kv">' + cell('Make', d.make) + cell('Model', d.model) + cell('Serial / service tag', d.serial) +
            cell('Operating system', d.os) + cell('CPU', d.cpu + (d.cpuCount && d.cpuCount !== '1' ? ' ×' + d.cpuCount : '')) + cell('GPU', d.gpu) +
            cell('RAM', d.ram) + cell('RAM type / config', d.ramType) + cell('Warranty', d.warranty) +
            cell('IP address(es)', d.ip) + cell('MAC address(es)', d.mac) + cell('Status', d.status) + '</div>' +
            '<h3>Disks</h3><table><tr><th style="width:18%">Type</th><th style="width:18%">Size</th><th>Model / serial</th></tr>' + rows + '</table>' +
            '<h3>Work performed</h3><div class="chk">' + WORK.map(function (w) { return '<div>' + box(d.checks.indexOf(w) >= 0) + esc(w) + '</div>'; }).join('') + '</div>' +
            '<div class="lines" style="margin-top:6px"><div><b>Details:</b> ' + esc(d.work) + '</div><div></div><div></div></div>' +
            '<h3>Parts used / replaced</h3><div class="lines"><div>' + esc(d.parts) + '</div><div></div></div>' +
            '<h3>Notes / issues found</h3><div class="lines"><div>' + esc(d.notes) + '</div><div></div><div></div></div>' +
            '<h3>Maintenance history</h3><table><tr><th style="width:16%">Date</th><th>Work done</th><th style="width:18%">Tech</th></tr>' + log + '</table>' +
            '<div class="sub" style="margin-top:6px">Next service due: <b>' + esc(d.next || '________________') + '</b></div>' +
            '<div class="sig"><div>Technician: ' + esc(d.tech) + '</div><div>Customer signature</div><div>Date</div></div></div>';
    }

    function tagHtml() {
        var sz = d.tagSize.split('x'), w = parseFloat(sz[0]), h = parseFloat(sz[1]);
        var fs = Math.max(8, Math.min(14, Math.round(Math.min(w * 3.6, h * 6) * 1.2)));
        var inner;
        var specLines = [d.cpu, [d.ram, d.ramType].filter(Boolean).join(' '), disksList().map(function (k) { return [k.size, k.type].filter(Boolean).join(' '); }).join(' + ')].filter(Boolean);
        if (d.mode === 'idtag') {
            inner = '<div class="tt"><span>' + esc(d.type.toUpperCase()) + (d.customer ? ' — ' + esc(d.customer) : '') + '</span><span>TL ID TAG</span></div>' +
                '<div class="big">' + esc(title()) + '</div>' +
                '<div class="specs">' + specLines.map(esc).join('<br>') +
                (d.os ? '<br>OS: ' + esc(d.os) : '') + (d.ip ? '<br>IP: ' + esc(d.ip) : '') + (d.serial ? '<br>S/N: ' + esc(d.serial) : '') + (d.location ? '<br>Loc: ' + esc(d.location) : '') + '</div>' +
                '<div class="spacer"></div>' + barcodeBlock();
        } else {
            var last = d.log.slice().sort(function (a, b) { return a.date < b.date ? 1 : -1; })[0];
            var total = h >= 3 ? 6 : h >= 2 ? 3 : h >= 1.6 ? 2 : 1;
            var rows = total > 1 ? d.log.slice(-(total - 1)) : [], r = '';
            rows.forEach(function (l) { r += '<tr><td>' + esc(l.date) + '</td><td>' + esc(l.work) + '</td><td>' + esc(l.tech) + '</td></tr>'; });
            var blanks = total - rows.length;
            for (var i = 0; i < blanks; i++) r += '<tr><td>&nbsp;</td><td></td><td></td></tr>';
            inner = '<div class="tt"><span>MAINTENANCE RECORD</span><span>' + esc(title()) + '</span></div>' +
                '<div class="specs"><b>' + esc(d.id) + '</b>' + (d.serial ? ' · S/N ' + esc(d.serial) : '') + (last ? '<br>Last service: ' + esc(last.date) : '') + (d.next ? ' · <b>Next due: ' + esc(d.next) + '</b>' : '') + '</div>' +
                '<table class="mlog"><tr><th style="width:24%">Date</th><th>Work done</th><th style="width:20%">Tech</th></tr>' + r + '</table>' +
                '<div class="spacer"></div>' + barcodeBlock();
        }
        var one = '<div class="sheet tag' + (h < 1.6 ? ' small' : '') + '" style="width:' + w + 'in;height:' + h + 'in;font-size:' + fs + 'px"><div class="tagbox">' + inner + '</div></div>';
        var out = '';
        for (var c = 0; c < d.copies; c++) out += one;
        return '<div class="tagsheet">' + out + '</div>';
    }

    function fitTags() {
        document.querySelectorAll('.sheet.tag').forEach(function (t) {
            var box = t.firstElementChild, fs = parseFloat(t.style.fontSize);
            while (box.scrollHeight > box.clientHeight + 1 && fs > 5) { fs -= 0.5; t.style.fontSize = fs + 'px'; }
        });
    }
    function fitZoom() {
        var w = $('stage').clientWidth, z = Math.min(1, (w - 4) / 820);
        $('out').style.zoom = z > 0.2 ? z : 1;
    }
    window.addEventListener('resize', fitZoom);
    function render() {
        $('out').innerHTML = d.mode === 'sheet' ? sheetHtml() : tagHtml();
        if (d.mode !== 'sheet') fitTags();
        fitZoom();
        document.title = 'Machine sheet - ' + d.id;
    }

    // ---------- Records ----------
    function getRecs() { try { return JSON.parse(localStorage.getItem('tlint_records') || '{}'); } catch (e) { return {}; } }
    function putRecs(r) { try { localStorage.setItem('tlint_records', JSON.stringify(r)); } catch (e) { alert('Could not save: browser storage is unavailable.'); } }
    function drawRecords() {
        var r = getRecs(), ids = Object.keys(r).sort(function (a, b) { return (r[b]._saved || 0) - (r[a]._saved || 0); });
        $('records').innerHTML = ids.length ? ids.map(function (id) {
            var x = r[id];
            return '<div class="row" style="margin-bottom:4px"><button class="alt" style="text-align:left;flex:1" data-load="' + esc(id) + '">' + esc(id) + ' — ' + esc(x.host || x.model || x.type || '') + '</button><button class="danger tiny" data-del="' + esc(id) + '">✕</button></div>';
        }).join('') : '<div class="hint">No saved records yet.</div>';
    }
    function loadRec(id) {
        var r = getRecs(); if (!r[id]) return false;
        d = Object.assign(blank(), JSON.parse(JSON.stringify(r[id]))); delete d._saved; fill(); return true;
    }
    $('saveBtn').onclick = function () {
        if (!d.id) d.id = newId();
        var r = getRecs(); r[d.id] = JSON.parse(JSON.stringify(d)); r[d.id]._saved = Date.now(); putRecs(r); drawRecords();
        $('saveBtn').textContent = '✔ Saved'; setTimeout(function () { $('saveBtn').textContent = '💾 Save record'; }, 1200);
    };
    $('newBtn').onclick = function () { var m = d.mode, t = d.tagSize; d = blank(); d.mode = m; d.tagSize = t; fill(); };
    $('records').addEventListener('click', function (e) {
        var l = e.target.closest('[data-load]'), x = e.target.closest('[data-del]');
        if (l) loadRec(l.dataset.load);
        else if (x && confirm('Delete record ' + x.dataset.del + '?')) { var r = getRecs(); delete r[x.dataset.del]; putRecs(r); drawRecords(); }
    });
    $('scanIn').addEventListener('keydown', function (e) {
        if (e.key !== 'Enter') return;
        var v = this.value.trim(); if (!v) return;
        var r = getRecs(), hit = Object.keys(r).filter(function (k) { return k.toLowerCase() === v.toLowerCase(); })[0];
        this.value = '';
        if (hit) loadRec(hit); else this.placeholder = 'No record for "' + v + '"';
    });
    $('exportBtn').onclick = function () {
        var blob = new Blob([JSON.stringify(getRecs(), null, 2)], { type: 'application/json' });
        var a = document.createElement('a'); a.href = URL.createObjectURL(blob); a.download = 'tl-machine-records.json'; a.click();
        setTimeout(function () { URL.revokeObjectURL(a.href); }, 1000);
    };
    $('importBtn').onclick = function () { $('importFile').click(); };
    $('importFile').onchange = function () {
        var f = this.files[0]; if (!f) return;
        var fr = new FileReader();
        fr.onload = function () {
            try {
                var inc = JSON.parse(fr.result), r = getRecs(), n = 0;
                Object.keys(inc).forEach(function (k) { if (inc[k] && typeof inc[k] === 'object') { r[k] = inc[k]; n++; } });
                putRecs(r); drawRecords(); alert('Imported ' + n + ' record(s).');
            } catch (e) { alert('That file is not valid JSON.'); }
        };
        fr.readAsText(f); this.value = '';
    };

    $('printBtn').onclick = function () { window.print(); };
    $('themeBtn').onclick = function () {
        document.body.classList.toggle('dark');
        try { localStorage.setItem('tlint_dark', document.body.classList.contains('dark') ? '1' : '0'); } catch (e) {}
        this.textContent = document.body.classList.contains('dark') ? '☀️' : '🌙';
    };
    try {
        var dk = localStorage.getItem('tlint_dark');
        if (dk === '1' || (dk === null && window.matchMedia && matchMedia('(prefers-color-scheme: dark)').matches)) { document.body.classList.add('dark'); $('themeBtn').textContent = '☀️'; }
    } catch (e) {}

    d = blank();
    fill();
    window.__tlint = { code128: code128, P: P };
})();
