<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>TL Machine Sheets 1.0</title>
<link rel="icon" type="image/png" href="TL.png">
<style>
    :root {
        --ink: #193b35; --muted: #5d766d; --paper: #f1f6f3; --surface: #ffffff; --line: #cddbd4;
        --green: #146b59; --green-wash: #e5f1ec; --coral: #c4462f; --shadow: 0 8px 24px rgba(25, 59, 53, 0.12);
        --font: ui-monospace, "DejaVu Sans Mono", "Liberation Mono", Consolas, monospace;
    }
    body.dark {
        --ink: #e4eee9; --muted: #a8bbb2; --paper: #182622; --surface: #22342e; --line: #3b5148;
        --green: #61b79b; --green-wash: #29483c; --coral: #ff9c83; --shadow: 0 8px 24px rgba(0, 0, 0, 0.3);
    }
    * { box-sizing: border-box; }
    body { margin: 0; color: var(--ink); background-color: var(--paper); font: 14px/1.5 var(--font);
        background-image: linear-gradient(rgba(25,59,53,0.04) 1px, transparent 1px), linear-gradient(90deg, rgba(25,59,53,0.04) 1px, transparent 1px); background-size: 28px 28px; }
    .topbar { position: sticky; top: 0; z-index: 5; display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 10px 24px; background: var(--surface); border-bottom: 1px solid var(--line); box-shadow: var(--shadow); }
    .brand { display: flex; align-items: center; gap: 10px; font-weight: 700; font-size: 1.1rem; }
    .brand img { width: 30px; height: 30px; }
    .brand small { color: var(--muted); font-weight: 400; font-size: 0.7rem; }
    .actions { display: flex; flex-wrap: wrap; gap: 7px; }
    button, select, input, textarea { font: inherit; color: var(--ink); }
    button { padding: 7px 12px; cursor: pointer; color: #fff; background: var(--green); border: 1px solid var(--green); border-radius: 4px; font-weight: 700; font-size: 0.8rem; }
    body.dark button { color: #10231d; }
    button.alt { color: var(--ink); background: var(--green-wash); border-color: var(--line); }
    body.dark button.alt { color: var(--ink); }
    button.danger { color: var(--coral); background: transparent; border-color: var(--line); }
    button.tiny { padding: 2px 8px; font-size: 0.72rem; }
    button:hover { filter: brightness(1.07); }
    .layout { display: grid; grid-template-columns: minmax(340px, 480px) 1fr; gap: 18px; padding: 18px 24px; align-items: start; }
    .panel { background: var(--surface); border: 1px solid var(--line); border-radius: 6px; padding: 14px 16px; margin-bottom: 14px; }
    .panel h2 { margin: 0 0 10px; font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--muted); }
    .grid { display: grid; grid-template-columns: 1fr 1fr; gap: 8px 10px; }
    .grid .full { grid-column: 1 / -1; }
    label { display: block; font-size: 0.72rem; color: var(--muted); margin-bottom: 2px; }
    input[type=text], input[type=date], input[type=number], select, textarea { width: 100%; padding: 6px 8px; background: var(--paper); border: 1px solid var(--line); border-radius: 4px; }
    textarea { resize: vertical; min-height: 60px; }
    input:focus, select:focus, textarea:focus { outline: 2px solid rgba(20,107,89,0.35); border-color: var(--green); }
    .seg { display: flex; gap: 0; }
    .seg button { flex: 1; border-radius: 0; color: var(--ink); background: var(--paper); border-color: var(--line); }
    .seg button:first-child { border-radius: 4px 0 0 4px; } .seg button:last-child { border-radius: 0 4px 4px 0; }
    .seg button.on { color: #fff; background: var(--green); border-color: var(--green); }
    body.dark .seg button { color: var(--ink); }
    body.dark .seg button.on { color: #10231d; }
    .diskrow { display: grid; grid-template-columns: 90px 80px 1fr auto; gap: 6px; margin-bottom: 6px; }
    .checks { display: grid; grid-template-columns: 1fr 1fr; gap: 3px 10px; }
    .checks label { display: flex; align-items: center; gap: 6px; color: var(--ink); font-size: 0.78rem; margin: 0; cursor: pointer; }
    .logrow { display: grid; grid-template-columns: 120px 1fr 80px auto; gap: 6px; margin-bottom: 6px; }
    .row { display: flex; gap: 6px; align-items: center; }
    .row > * { flex: 1; } .row > button { flex: 0 0 auto; }
    .hint { color: var(--muted); font-size: 0.72rem; margin-top: 4px; }
    #stage { overflow: auto; padding-bottom: 30px; min-width: 0; }
    #form { min-width: 0; }
    @media (min-width: 1001px) { .layout { grid-template-columns: 480px minmax(0, 1fr); } }

    /* ----- Printable sheet (always white) ----- */
    .sheet { background: #fff; color: #000; box-shadow: var(--shadow); font: 12px/1.35 Arial, Helvetica, sans-serif; padding: 0.4in; margin: 0 auto 18px; }
    .sheet.page { width: 8.5in; min-height: 11in; }
    .sheet h1 { margin: 0; font-size: 20px; }
    .sheet h3 { margin: 12px 0 4px; font-size: 11px; text-transform: uppercase; letter-spacing: 0.06em; border-bottom: 1.5px solid #000; padding-bottom: 2px; }
    .sheet .head { display: flex; justify-content: space-between; align-items: flex-start; gap: 18px; border-bottom: 3px solid #000; padding-bottom: 8px; }
    .sheet .sub { color: #444; font-size: 11px; }
    .sheet table { width: 100%; border-collapse: collapse; }
    .sheet td, .sheet th { border: 1px solid #000; padding: 3px 6px; text-align: left; vertical-align: top; font-size: 11px; }
    .sheet th { background: #e6e6e6; font-size: 10px; text-transform: uppercase; }
    .sheet .kv { display: grid; grid-template-columns: repeat(3, 1fr); border: 1px solid #000; }
    .sheet .kv div { padding: 3px 6px; border: 0.5px solid #999; min-height: 32px; }
    .sheet .kv b { display: block; font-size: 9px; text-transform: uppercase; color: #444; }
    .sheet .chk { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 2px 10px; }
    .sheet .box { display: inline-block; width: 10px; height: 10px; border: 1.3px solid #000; margin-right: 5px; vertical-align: -1px; text-align: center; line-height: 8px; font-size: 10px; font-weight: 700; }
    .sheet .lines div { border-bottom: 1px solid #777; min-height: 20px; white-space: pre-wrap; }
    .sheet .sig { display: flex; gap: 24px; margin-top: 18px; }
    .sheet .sig div { flex: 1; border-top: 1px solid #000; padding-top: 2px; font-size: 10px; color: #444; }
    .bc { text-align: center; }
    .bc svg { display: block; width: 100%; height: 0.6in; }
    .bc .code { font: 700 12px "Courier New", monospace; letter-spacing: 0.08em; }
    .sheet.tag { padding: 0.06in; overflow: hidden; margin: 0; border: 1px dashed #999; }
    .tag .tagbox { height: 100%; display: flex; flex-direction: column; gap: 3px; border: 2px solid #000; padding: 4px 6px; }
    .tag .tt { display: flex; justify-content: space-between; align-items: baseline; gap: 6px; border-bottom: 2px solid #000; font-weight: 700; }
    .tag .tt span:first-child { font-size: 1.05em; } .tag .tt span:last-child { font-size: 0.75em; text-align: right; }
    .tag .big { font-size: 1.3em; font-weight: 800; line-height: 1.15; }
    .tag .specs { font-size: 0.8em; line-height: 1.3; }
    .tag .mlog { width: 100%; border-collapse: collapse; font-size: 0.75em; }
    .tag .mlog td, .tag .mlog th { border: 1px solid #000; padding: 0 3px; height: 1.6em; text-align: left; }
    .tag .spacer { flex: 1; }
    .tag .bc svg { height: 0.42in; }
    .tag.small .bc svg { height: 0.28in; }
    .tag.small .tagbox { padding: 2px 4px; gap: 1px; }
    .tag .bc .code { font-size: 0.9em; line-height: 1.1; }
    .tag .tagbox { overflow: hidden; }
    .tag .mlog { table-layout: fixed; }
    .tag .mlog td { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .tag .mlog td, .tag .mlog th { height: 1.4em; }
    .tagsheet { display: flex; flex-wrap: wrap; gap: 0.1in; justify-content: flex-start; background: #fff; padding: 0.25in; width: 8.5in; margin: 0 auto 18px; box-shadow: var(--shadow); }
    .tagsheet .sheet.tag { box-shadow: none; }

    @media (max-width: 1000px) { .layout { grid-template-columns: 1fr; } }
    @media print {
        body { background: #fff !important; }
        .topbar, #form { display: none !important; }
        .layout { display: block; padding: 0; }
        #stage { overflow: visible; padding: 0; }
        .sheet, .tagsheet { box-shadow: none !important; margin: 0 !important; }
        #out { zoom: 1 !important; }
        .sheet.page { width: auto; min-height: 0; padding: 0; }
        .sheet.tag { border-color: transparent; }
        .tagsheet { padding: 0; width: auto; }
    }
    @page { size: letter; margin: 0.4in; }
    .full { position: relative; }
    .cpu-menu { position: absolute; left: 0; right: 0; top: 100%; z-index: 30; max-height: 280px; overflow-y: auto; background: var(--surface); border: 1.5px solid var(--green); border-radius: 8px; box-shadow: var(--shadow); margin-top: 2px; }
    .cpu-menu[hidden] { display: none; }
    .cpu-menu .grp { padding: 5px 10px; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: .05em; color: var(--muted); background: var(--green-wash); position: sticky; top: 0; }
    .cpu-menu .opt { padding: 6px 10px; font-size: 13px; cursor: pointer; color: var(--ink); }
    .cpu-menu .opt:hover, .cpu-menu .opt.on { background: var(--green-wash); color: var(--green); }
</style>
</head>
<body>
<header class="topbar">
    <div class="brand"><img src="TL.png" alt="">TL Machine Sheets <small>1.0</small></div>
    <div class="actions">
        <button id="printBtn">🖨 Print</button>
        <button class="alt" id="saveBtn">💾 Save record</button>
        <button class="alt" id="newBtn">New</button>
        <button class="alt" id="themeBtn" title="Toggle dark mode">🌙</button>
    </div>
</header>

<div class="layout">
<div id="form">
    <div class="panel">
        <h2>Output</h2>
        <div class="seg" id="modeSeg">
            <button data-mode="sheet" class="on">Work sheet</button>
            <button data-mode="idtag">ID tag</button>
            <button data-mode="mtag">Maintenance tag</button>
        </div>
        <div class="grid" style="margin-top:8px" id="tagOpts">
            <div><label>Tag size</label>
                <select id="tagSize">
                    <option value="4x2">4 × 2 in (shipping label)</option>
                    <option value="3x2">3 × 2 in</option>
                    <option value="4x3">4 × 3 in</option>
                    <option value="2.25x1.25">2.25 × 1.25 in (small)</option>
                    <option value="5x3.5">5 × 3.5 in (large)</option>
                </select></div>
            <div><label>Copies on the page</label><input type="number" id="copies" min="1" max="24" value="1"></div>
        </div>
        <div class="hint" id="modeHint"></div>
    </div>

    <div class="panel">
        <h2>Identification &amp; barcode</h2>
        <div class="grid">
            <div class="full"><label>Asset ID (barcode value, Code 128)</label>
                <div class="row"><input type="text" data-k="id" id="idIn" autocomplete="off"><button class="alt" id="genId" type="button">New ID</button></div></div>
            <div><label>Hostname / name</label><input type="text" data-k="host"></div>
            <div><label>Type / role</label>
                <select data-k="type"><option>Desktop</option><option>Laptop</option><option>Server</option><option>Workstation</option><option>All-in-one</option><option>Mini PC / NUC</option><option>Chromebook</option><option>Tablet</option><option>Raspberry Pi / SBC</option><option>VM host</option><option>Other</option></select></div>
            <div><label>Customer / owner</label><input type="text" data-k="customer"></div>
            <div><label>Location / rack / bench</label><input type="text" data-k="location"></div>
            <div><label>Make</label><input type="text" data-k="make" placeholder="Dell, HP, Lenovo…"></div>
            <div><label>Model</label><input type="text" data-k="model"></div>
            <div><label>Serial / service tag</label><input type="text" data-k="serial"></div>
            <div><label>Operating system</label><input type="text" data-k="os" placeholder="Windows 11 Pro, Ubuntu 24.04…"></div>
        </div>
    </div>

    <div class="panel">
        <h2>Hardware</h2>
        <div class="grid">
            <div class="full"><label>CPU (pick from the TLCPU list or type your own)</label>
                <input type="text" data-k="cpu" id="cpuIn"                 placeholder="Start typing, e.g. i5-8250U, Xeon Gold or EPYC" autocomplete="off" role="combobox" aria-expanded="false">
                                <div id="cpuMenu" class="cpu-menu" hidden></div></div>
            <div><label>CPU count / sockets</label><input type="text" data-k="cpuCount" placeholder="1"></div>
            <div><label>RAM total</label><input type="text" data-k="ram" placeholder="16 GB"></div>
            <div><label>RAM type / config</label><input type="text" data-k="ramType" placeholder="DDR4 2×8 GB"></div>
            <div><label>GPU</label><input type="text" data-k="gpu"></div>
        </div>
        <label style="margin-top:10px">Disks</label>
        <div id="disks"></div>
        <button class="alt tiny" id="addDisk" type="button">+ Add disk</button>
        <div class="grid" style="margin-top:10px">
            <div><label>IP address(es)</label><input type="text" data-k="ip"></div>
            <div><label>MAC address(es)</label><input type="text" data-k="mac"></div>
        </div>
    </div>

    <div class="panel">
        <h2>Work performed</h2>
        <div class="grid" style="margin-bottom:8px">
            <div><label>Date</label><input type="date" data-k="date"></div>
            <div><label>Technician</label><input type="text" data-k="tech"></div>
            <div><label>Ticket / job #</label><input type="text" data-k="ticket"></div>
            <div><label>Status</label>
                <select data-k="status"><option>In progress</option><option>Complete</option><option>Waiting on parts</option><option>Waiting on customer</option><option>Needs follow-up</option></select></div>
        </div>
        <div class="checks" id="checks"></div>
        <div class="grid" style="margin-top:8px">
            <div class="full"><label>Other work / details</label><textarea data-k="work"></textarea></div>
            <div class="full"><label>Parts used / replaced</label><textarea data-k="parts" style="min-height:44px"></textarea></div>
            <div class="full"><label>Notes / issues found</label><textarea data-k="notes" style="min-height:44px"></textarea></div>
            <div><label>Next service due</label><input type="date" data-k="next"></div>
            <div><label>Warranty / expires</label><input type="text" data-k="warranty"></div>
        </div>
    </div>

    <div class="panel">
        <h2>Maintenance history (printed on the tag / sheet)</h2>
        <div id="log"></div>
        <button class="alt tiny" id="addLog" type="button">+ Add entry</button>
        <button class="alt tiny" id="logFromWork" type="button">Add this work as an entry</button>
    </div>

    <div class="panel">
        <h2>Saved records (this browser)</h2>
        <div class="row"><input type="text" id="scanIn" placeholder="Scan or type an Asset ID, press Enter" autocomplete="off"></div>
        <div class="hint">A barcode scanner types the ID like a keyboard, so scanning here loads the record.</div>
        <div id="records" style="margin-top:8px"></div>
        <div class="row" style="margin-top:8px">
            <button class="alt tiny" id="exportBtn" type="button">Export JSON</button>
            <button class="alt tiny" id="importBtn" type="button">Import JSON</button>
            <input type="file" id="importFile" accept=".json,application/json" hidden>
        </div>
    </div>
</div>

<div id="stage"><div id="out"></div></div>
</div>

